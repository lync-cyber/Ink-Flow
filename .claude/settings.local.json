{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:www.axtonliu.ai)",
      "WebFetch(domain:www.woshipm.com)",
      "Bash(git init:*)",
      "Bash(for dir:*)",
      "Bash(do touch:*)",
      "Bash(done)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(chmod +x .claude/validators/contract-validator.sh)",
      "Bash(.claude/validators/contract-validator.sh:*)",
      "Bash(git status:*)"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date '+%Y-%m-%d %H:%M:%S')] SubagentStop: agent completed\" >> retro/runs/current.log.md"
          }
        ]
      }
    ]
  }
}
