{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Agent",
      "AskUserQuestion",
      "TodoWrite"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python framework/tools/profile_resolver.py --refresh-if-stale 3600 --quiet"
          }
        ]
      }
    ]
  }
}
