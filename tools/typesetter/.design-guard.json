{
  "$comment": "InkFlow 覆盖层主题反 AI 设计宪章的可机器校验子集。宪章文档：DESIGN-MANIFESTO.md",
  "version": "1.0",
  "scan": ["overlay/theme-css/*.css"],
  "forbidden": [
    {
      "id": "ai-gradient-purple-blue",
      "pattern": "linear-gradient\\([^)]*(violet|purple|indigo|#[89a-f][0-9a-f]{5}|#[0-9a-f]{2}4[6-9a-f][ef][0-9a-f]{2})",
      "reason": "AI 默认紫蓝渐变（宪章 2.4）"
    },
    {
      "id": "glassmorphism",
      "pattern": "backdrop-filter\\s*:\\s*blur",
      "reason": "玻璃拟态（宪章 2.2）"
    },
    {
      "id": "neon-glow",
      "pattern": "box-shadow\\s*:\\s*0\\s+0\\s+\\d+px",
      "reason": "霓虹发光描边（宪章 2.2）"
    },
    {
      "id": "stacked-shadow",
      "pattern": "box-shadow\\s*:(?:\\([^)]*\\)|[^;,(])+,(?:\\([^)]*\\)|[^;,(])+,",
      "reason": "多层堆叠阴影（≥ 3 层；宪章 2.2）"
    },
    {
      "id": "oversized-radius",
      "pattern": "border-radius\\s*:\\s*(2[4-9]|[3-9]\\d|\\d{3,})px",
      "reason": "过度圆角 ≥ 24px（宪章 2.2）"
    },
    {
      "id": "wechat-strip-position",
      "pattern": "position\\s*:\\s*(absolute|fixed|sticky)",
      "reason": "微信粘贴时剥离 position"
    },
    {
      "id": "wechat-strip-animation",
      "pattern": "(@keyframes|\\banimation\\s*:\\s*(?!none))",
      "reason": "微信剥离动画，且强化模板感"
    },
    {
      "id": "wechat-strip-media",
      "pattern": "@media\\s+(?!print)",
      "reason": "微信不支持响应式 media query（print 除外）"
    },
    {
      "id": "text-gradient",
      "pattern": "-webkit-background-clip\\s*:\\s*text",
      "reason": "文本渐变填充（AI 模板常用）"
    }
  ],
  "cautious": [
    {
      "id": "heavy-shadow-alpha",
      "pattern": "box-shadow\\s*:[^;]*rgba\\([^)]+,\\s*0\\.(1[3-9]|[2-9])",
      "reason": "阴影透明度 > 0.12，检查是否过于明显（宪章 2.2）"
    },
    {
      "id": "hardcoded-white-bg",
      "pattern": "(background|background-color)\\s*:\\s*(#fff\\b|#ffffff\\b|\\bwhite\\b)",
      "reason": "硬编码白背景破坏 dark mode 适配；用 hsl(var(--background))"
    }
  ]
}
